; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Gamepad Led Manager"
run/main_scene="uid://r5b5to7jvuet"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="uid://c08cshq4plrt1"

[autoload]

GamepadLedManager="*uid://bo44rbcj2md47"

[display]

window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="Gamepad Led Manager"

[editor_plugins]

enabled=PackedStringArray("res://addons/gamepad_led_manager/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

